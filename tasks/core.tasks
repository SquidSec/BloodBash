# BloodBash example task list (MIT). Layout matches the PlumHound task format.
# Run: bloodbash DIR --tasks tasks/core.tasks --tasks-out ./task-reports
["Domains", "HTMLCSV", "Domains", "MATCH (d:Domain) RETURN d.name AS Domain, d.functionallevel AS FunctionalLevel, d.domain AS DNS, d.distinguishedname AS DN, d.domainsid AS SID"]
["Domain Trusts", "HTMLCSV", "DomainTrusts", "MATCH (a:Domain)-[r:TrustedBy]->(b:Domain) RETURN a.name AS Domain1, b.name AS Domain2, r.trusttype AS TrustType, r.sidfiltering AS SidFiltering"]
["Domain Controllers", "HTMLCSV", "DomainControllers", "MATCH (c:Computer)-[:MemberOf]->(g:Group) WHERE g.objectid ENDS WITH '-516' RETURN c.name AS Hostname, c.operatingsystem AS OS, c.haslaps AS LAPS, c.enabled AS Enabled, c.distinguishedname AS DN"]
["Domain Admins (Direct)", "HTML", "DomainAdmins", "MATCH (g:Group)<-[:MemberOf]-(m) WHERE g.objectid =~ '(?i)S-1-5-.*-512' RETURN m.name AS Name, m.displayname AS DisplayName, head(labels(m)) AS Type, m.enabled AS Enabled, m.pwdneverexpires AS PWDNeverExpire"]
["Enterprise Admins (Direct)", "HTML", "EnterpriseAdmins", "MATCH (g:Group)<-[:MemberOf]-(m) WHERE g.objectid =~ '(?i)S-1-5-.*-519' RETURN m.name AS Name, m.displayname AS DisplayName, head(labels(m)) AS Type, m.enabled AS Enabled"]
["Domain Users", "HTMLCSV", "DomainUsers", "MATCH (u:User) RETURN u.name AS Name, u.displayname AS DisplayName, u.enabled AS Enabled, u.description AS Description, u.admincount AS AdminCount, u.hasspn AS HasSPN, u.pwdneverexpires AS PWDNeverExpires"]
["Domain Computers", "HTMLCSV", "DomainComputers", "MATCH (c:Computer) RETURN c.name AS Name, c.domain AS Domain, c.enabled AS Enabled, c.haslaps AS LAPS, c.highvalue AS HighValue, c.operatingsystem AS OS ORDER BY c.name"]
["Kerberoastable Users", "HTML", "Kerberoastable", "MATCH (u:User) WHERE u.hasspn = true RETURN u.name AS Username, u.displayname AS DisplayName, u.enabled AS Enabled, u.admincount AS AdminCount, u.serviceprincipalnames AS SPNs"]
["AS-REP Roastable Users", "HTML", "ASREPRoastable", "MATCH (u:User) WHERE u.dontreqpreauth = true RETURN u.name AS Username, u.enabled AS Enabled, u.admincount AS AdminCount, u.lastlogontimestamp AS LastLogon"]
["Admin Groups", "HTMLCSV", "AdminGroups", "MATCH (g:Group) WHERE toUpper(g.name) CONTAINS 'ADMIN' RETURN g.name AS Name, g.highvalue AS HighValue, g.description AS Description, g.admincount AS AdminCount"]
["High Value Group Membership", "HTMLCSV", "HighValueMembers", "MATCH (u:User)-[:MemberOf]->(g:Group {highvalue:true}) RETURN u.name AS User, u.enabled AS Enabled, g.name AS Group"]
["DCSync Principals", "HTMLCSV", "DCSync", "MATCH (p)-[:DCSync]->(d:Domain) RETURN d.name AS Domain, p.name AS Principal, head(labels(p)) AS Type"]
["Unconstrained Delegation", "HTML", "UnconstrainedDelegation", "MATCH (c:Computer) WHERE c.unconstraineddelegation = true RETURN c.name AS Computer, c.operatingsystem AS OS, head(labels(c)) AS Type"]
["Local Admins (Users)", "HTMLCSV", "LocalAdmins", "MATCH (p)-[:AdminTo]->(c:Computer) RETURN p.name AS Principal, head(labels(p)) AS PrincipalType, c.name AS Computer ORDER BY Principal"]
["Sessions", "HTMLCSV", "Sessions", "MATCH (c:Computer)-[:HasSession]->(u:User) RETURN c.name AS Computer, u.name AS Username"]
["Computers Without LAPS", "HTMLCSV", "LAPSMissing", "MATCH (c:Computer) WHERE c.haslaps = false RETURN c.name AS Computer, c.operatingsystem AS OS, c.enabled AS Enabled ORDER BY Computer"]
["Over-Privileged Everyone Edges", "HTMLCSV", "EveryoneEdges", "MATCH (g:Group)-[r]->(n) WHERE g.objectid ENDS WITH 'S-1-1-0' AND type(r) <> 'MemberOf' RETURN g.name AS Subject, type(r) AS Relationship, n.name AS Target, n.enabled AS Enabled"]
["Top Admins by AdminTo Count", "CSV", "BulkAdminTo", "MATCH (p)-[:AdminTo]->(c:Computer) RETURN p.name AS Principal, count(DISTINCT c.name) AS HostCount ORDER BY HostCount DESC LIMIT 50"]
["Kerberoast Path to Domain Admins", "HTML", "KerbPathToDA", "MATCH p=shortestPath((u:User {hasspn:true})-[:MemberOf*1..6]->(g:Group)) WHERE toUpper(g.name) CONTAINS 'DOMAIN ADMINS' RETURN DISTINCT u.name AS User, g.name AS Group"]
["Report Index", "HTML", "index", "REPORT-INDEX"]
